{
  "schemaVersion": 1,
  "status": "initialized",
  "tooling": {
    "runtime": "node",
    "packageManager": "npm"
  },
  "decisions": {
    "language": "C++20",
    "runtime": "CMake + SDL2 + OpenGL",
    "frontend": "Asset Studio + Map Studio",
    "backend": "none",
    "storage": "JSON project metadata and filesystem assets",
    "deployment": "desktop archives",
    "observability": "local structured logs and debug overlay",
    "security": "validated local asset paths and schemas",
    "performance": "60 FPS desktop target"
  },
  "commands": {
    "test": "npm test",
    "lint": null,
    "typecheck": null,
    "mutation": null,
    "integration": null,
    "build": "npm run validate:cpp",
    "mermaid": "npm run validate:docs"
  },
  "quality": {
    "mutation": {
      "decision": "not-applicable",
      "preCommit": false,
      "prePush": false
    }
  },
  "directories": {
    "source": ["engine/", "editors/", "game/", "tools/"],
    "tests": ["tests/"],
    "generated": ["coverage/", "dist/", "build/", ".ctxroute/state/"]
  },
  "codeExtensions": [".cpp", ".hpp", ".h", ".cmake"],
  "architecture": {
    "documents": [
      "docs/architecture/context.md",
      "docs/architecture/containers.md"
    ]
  },
  "contracts": {
    "patterns": [
      "package.json",
      "**/package.json",
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/bun.lock",
      "**/pyproject.toml",
      "**/requirements*.txt",
      "**/Pipfile",
      "**/poetry.lock",
      "**/uv.lock",
      "**/Cargo.toml",
      "**/Cargo.lock",
      "**/go.mod",
      "**/go.sum",
      "**/pom.xml",
      "**/build.gradle",
      "**/build.gradle.kts",
      "**/composer.json",
      "**/composer.lock",
      "**/Gemfile",
      "**/Gemfile.lock",
      "**/*.proto",
      "**/openapi*.yaml",
      "**/openapi*.yml",
      "**/openapi*.json",
      "**/*.graphql",
      "**/*.gql"
    ]
  },
  "starter": {
    "infrastructureRoots": [
      ".codex/",
      ".claude/",
      ".githooks/",
      ".github/",
      ".project/",
      "docs/",
      "rules/"
    ],
    "rootFiles": [
      ".gitignore",
      ".gitmessage",
      ".gitattributes",
      "AGENTS.md",
      "CLAUDE.md",
      "CONTRIBUTING.md",
      "LICENSE",
      "NOTICE",
      "README.md",
      "SECURITY.md",
      "THIRD_PARTY_NOTICES.md",
      "ctxroute-config.json",
      "package.json",
      "package-lock.json"
    ]
  }
}
